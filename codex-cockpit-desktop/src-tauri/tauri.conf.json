{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-cockpit-desktop",
  "version": "0.1.0",
  "identifier": "com.braydio.codex-cockpit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "package": {
    "productName": "Codex Cockpit",
    "version": "0.1.0"
  },
  "tauri",
    "app": {
      "windows": [
        {
          "title": "Codex Cockpit",
          "width": 1200,
          "height": 800,
	  "resizeable": true,
	  "fullscreen": false
	}
      ],
      "security": {
        "csp": null
      }
    },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
